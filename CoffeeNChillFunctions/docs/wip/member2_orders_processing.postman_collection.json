  "item": [
    {
      "name": "Setup - queue an order",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// ST10472017",
              "// Postman, 2026. Test examples in Postman. [Online]",
              "// Available at: https://learning.postman.com/docs/tests-and-scripts/write-scripts/test-examples/",
              "// [Accessed 12 October 2026].",
              "// Postman, 2026. Store and reuse values using variables. [Online]",
              "// Available at: https://learning.postman.com/docs/sending-requests/variables/variables/",
              "// [Accessed 12 October 2026].",
              "",
              "const id = \"ORD-2026-\" + Math.floor(1000 + Math.random() * 9000);",
              "pm.collectionVariables.set(\"statusOrderId\", id);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Order accepted\", () => pm.response.to.have.status(202));",
              "pm.test(\"Response carries the order id\", () =>",
              "    pm.expect(pm.response.json().orderId).to.eql(pm.collectionVariables.get(\"statusOrderId\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders/queue",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "queue"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"OrderId\": \"{{statusOrderId}}\",\n  \"CustomerName\": \"Status Test Student\",\n  \"SelectedItemSKUs\": [\n    \"COF-001\",\n    \"PAS-104\"\n  ],\n  \"TotalPrice\": 65.0\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Get order by id - wait for Received",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(function () {}, 3000);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Order exists in the Orders table\", () => pm.response.to.have.status(200));",
              "const order = pm.response.json();",
              "pm.test(\"OrderId matches\", () =>",
              "    pm.expect(order.orderId).to.eql(pm.collectionVariables.get(\"statusOrderId\")));",
              "pm.test(\"Status is a valid lifecycle value\", () =>",
              "    pm.expect([\"Received\", \"Preparing\", \"Ready\", \"Collected\"]).to.include(order.status));",
              "pm.test(\"Orders row carries the customer and items\", () => {",
              "    pm.expect(order.customerName).to.eql(\"Status Test Student\");",
              "    pm.expect(order.selectedItemSKUs).to.have.lengthOf(2);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/orders/{{statusOrderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "{{statusOrderId}}"
          ]
        }
      }
    },
