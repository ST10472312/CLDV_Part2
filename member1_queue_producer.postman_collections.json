  "item": [
    {
      "name": "Queue order - valid",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "   pm.test(\"Status is 202 Accepted\", () => pm.response.to.have.status(202));\r\n   const json = pm.response.json();\r\n   pm.test(\"Response says Queued\", () => pm.expect(json.status).to.eql(\"Queued\"));\r\n   pm.test(\"OrderId returned\", () => pm.expect(json.orderId).to.be.a(\"string\").and.not.empty);\r\n   pm.collectionVariables.set(\"orderId\", json.orderId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "   {\"OrderId\":\"ORD-2026-8801\",\"CustomerName\":\"Jane Smith\",\"SelectedItemSKUs\":[\"COF-001\",\"PAS-104\"],\"TotalPrice\":65.00,\"OrderTimestamp\":\"2026-10-12T10:15:00Z\"}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/orders/queue",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "queue"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Queue order - server generates id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 202\", () => pm.response.to.have.status(202));\r\npm.test(\"Server generated an OrderId\", () => {\r\n    pm.expect(pm.response.json().orderId).to.match(/^ORD-\\d{4}-[A-Z0-9]{6}$/);\r\n});\r\npm.collectionVariables.set(\"generatedOrderId\", pm.response.json().orderId);"
            ]
          }
        }
      ],
